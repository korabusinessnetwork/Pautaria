{
  "name": "pautaria",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Sistema de pauta adaptável por ofício, o ofício é a configuração.",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "validar": "npm run lint && npm run typecheck && npm test && npm run build",
    "seguranca:audit": "npm audit --audit-level=high",
    "seguranca:segredos": "bash scripts/checar-segredos.sh",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "fn:deploy": "supabase functions deploy",
    "fn:serve": "supabase functions serve --env-file supabase/.env",
    "telas": "node scripts/checar-transbordo.mjs",
    "telas:mobile": "node scripts/checar-transbordo.mjs 390"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.3",
    "@tanstack/react-query": "5.101.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.18.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "6.5.0",
    "@testing-library/react": "16.0.1",
    "@testing-library/user-event": "14.5.2",
    "@types/node": "22.19.4",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.5",
    "globals": "17.11.0",
    "jsdom": "30.0.1",
    "typescript": "5.6.2",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
